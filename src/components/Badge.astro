---
interface Props {
  status?: "disponible" | "trabajando"
  availableText: string
  workingText: string
}

const {
  status = "trabajando",
  availableText,
  workingText,
} = Astro.props
---

<div class="flex items-center">
  <span
    id="status-badge"
    class="relative inline-flex overflow-hidden rounded-full p-[1px]"
    data-status={status}
    data-available={availableText}
    data-working={workingText}
  >
    <span
      class="absolute inset-[-1000%] animate-[spin_2s_linear_infinite] bg-[conic-gradient(from_90deg_at_50%_50%,#E45151_0%,#552121_50%,#E45151_100%)]"
      id="badge-animation"
    ></span>
    <div
      id="badge-container"
      class="inline-flex items-center justify-center w-full px-3 py-1 text-sm rounded-full text-red-800 dark:text-red-400 bg-red-100 dark:bg-red-900/30 backdrop-blur-3xl whitespace-nowrap"
    >
      <span id="badge-text">{workingText}</span>
    </div>
  </span>
</div>

<script>
  function setupBadge() {
    const badge = document.getElementById("status-badge")
    const badgeText = document.getElementById("badge-text")
    const badgeContainer = document.getElementById("badge-container")
    const badgeAnimation = document.getElementById("badge-animation")

    if (!badge || !badgeText || !badgeContainer || !badgeAnimation) return

    const statusConfig = {
      disponible: {
        text: badge.dataset.available || "",
        textColor: "text-green-800 dark:text-green-400",
        bgColor: "bg-green-100 dark:bg-green-900/30",
        animation:
          "bg-[conic-gradient(from_90deg_at_50%_50%,#51E4B8_0%,#21554E_50%,#51E4B8_100%)]",
      },
      trabajando: {
        text: badge.dataset.working || "",
        textColor: "text-red-800 dark:text-red-400",
        bgColor: "bg-red-100 dark:bg-red-900/30",
        animation:
          "bg-[conic-gradient(from_90deg_at_50%_50%,#E45151_0%,#552121_50%,#E45151_100%)]",
      },
    }

    const currentStatus =
      (badge.dataset.status as keyof typeof statusConfig) || "trabajando"

    const updateBadge = (status: keyof typeof statusConfig) => {
      const config = statusConfig[status]
      badgeText.textContent = config.text
      badgeContainer.className = `inline-flex items-center justify-center w-full px-3 py-1 text-sm rounded-full ${config.textColor} ${config.bgColor} backdrop-blur-3xl whitespace-nowrap`
      badgeAnimation.className = `absolute inset-[-1000%] animate-[spin_2s_linear_infinite] ${config.animation}`
    }

    updateBadge(currentStatus)
  }

  setupBadge()
  document.addEventListener("astro:page-load", setupBadge)
</script>
