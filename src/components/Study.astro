---
import StudyItem from "./StudyItem.astro"
import type { Translation } from "@/i18n"

interface Props {
  t: Translation
}

const { t } = Astro.props
---

<ol class="relative mt-16">
  {
    t.education.items.map((item) => (
      <li>
        <StudyItem {...item} />
      </li>
    ))
  }
</ol>
