---
import LinkInline from "./LinkInline.astro"

interface Props {
  title: string
  company: string
  location?: string
  description: string
  link?: string
  date: string
  skills?: string[]
  moreLabel: string
}

const { title, company, location, description, link, date, skills = [], moreLabel } =
  Astro.props
---

<div
  class="relative mx-12 pb-12 grid before:absolute before:start-[-35px] before:block before:h-full before:border-s-2 before:border-black/20 dark:before:border-white/15 before:content-[''] md:grid-cols-5 md:gap-10"
>
  <div class="relative pb-12 md:col-span-2">
    <div class="sticky top-0">
      <span class="text-yellow-400 -start-[42px] absolute rounded-full text-5xl"
        >&bull;</span
      >

      <h3 class="text-xl font-bold text-yellow-400">{title}</h3>
      <h4 class="font-semibold text-xl text-gray-600 dark:text-white">{company}</h4>
      {
        location && (
          <p class="text-sm text-gray-500 dark:text-white/70">{location}</p>
        )
      }
      <time class="p-0 m-0 text-sm text-gray-600/80 dark:text-white/80">{date}</time>
    </div>
  </div>
  <div class="relative flex flex-col gap-2 pb-4 text-gray-600 dark:text-gray-300 md:col-span-3">
    <p>{description}</p>
    {
      skills.length > 0 && (
        <ul class="flex flex-wrap gap-2 mt-1">
          {skills.map((skill) => (
            <li class="px-2 py-0.5 text-xs rounded-full border border-yellow-500/30 bg-yellow-500/10 text-yellow-800 dark:text-yellow-200">
              {skill}
            </li>
          ))}
        </ul>
      )
    }
    {
      link && (
        <LinkInline href={link}>
          {moreLabel}{" "}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-5 icon icon-tabler icon-tabler-chevron-right rtl:rotate-180"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
            <path d="M9 6l6 6l-6 6" />
          </svg>
        </LinkInline>
      )
    }
  </div>
</div>
