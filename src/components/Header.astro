---
import ThemeToggle from "./ThemeToggle.astro"
import LanguageToggle from "./LanguageToggle.astro"
import { PROFILE, localePath, type Locale, type Translation } from "@/i18n"

interface Props {
  locale: Locale
  t: Translation
}

const { locale, t } = Astro.props
const home = localePath(locale)

const navItems = [
  { title: t.nav.experience, label: "experiencia", url: `${home}#experiencia` },
  { title: t.nav.education, label: "estudio", url: `${home}#estudio` },
  { title: t.nav.projects, label: "proyectos", url: `${home}#proyectos` },
  { title: t.nav.about, label: "sobre-mi", url: `${home}#sobre-mi` },
  { title: t.nav.contact, label: "contacto", url: `mailto:${PROFILE.email}` },
]
---

<header
  class="fixed top-0 z-10 flex items-center justify-center w-full mx-auto mt-2"
>
  <nav
    class="flex px-2 sm:px-3 text-[11px] sm:text-sm font-medium rounded-full text-gray-600 dark:text-gray-200 justify-center items-center max-w-[calc(100%-0.75rem)]"
  >
    <div class="flex items-center overflow-x-auto">
      {
        navItems.map((link) => (
          <a
            class="relative block px-1.5 sm:px-2 py-2 transition hover:text-yellow-500 dark:hover:text-yellow-400 whitespace-nowrap"
            data-nav-link
            aria-label={link.label}
            href={link.url}
          >
            {link.title}
          </a>
        ))
      }
    </div>
    <LanguageToggle locale={locale} label={t.language.label} />
    <ThemeToggle
      label={t.theme.label}
      light={t.theme.light}
      dark={t.theme.dark}
      system={t.theme.system}
    />
  </nav>
</header>

<script>
  document.addEventListener("astro:page-load", () => {
    const sections = document.querySelectorAll("section")
    const navItems = document.querySelectorAll("header nav a[data-nav-link]")

    const callback = (entries: IntersectionObserverEntry[]) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navItems.forEach((item) => {
            if (item.getAttribute("aria-label") == entry.target.id) {
              item.classList.add("text-yellow-500")
            } else {
              item.classList.remove("text-yellow-500")
            }
          })
        }
      })
    }

    const observer = new IntersectionObserver(callback, {
      root: null,
      rootMargin: "0px",
      threshold: 0.3,
    })

    sections.forEach((section) => {
      observer.observe(section)
    })

    document.onvisibilitychange = () => {
      if (document.visibilityState === "hidden") {
        observer.disconnect()
      } else {
        sections.forEach((section) => {
          observer.observe(section)
        })
      }
    }
  })
</script>

<style>
  nav {
    animation: nav-shadown 1s linear both;
    animation-timeline: scroll();
    animation-range: 0 100px;
  }

  @keyframes nav-shadown {
    to {
      @apply shadow-lg ring-1 backdrop-blur dark:bg-gray-800/90 bg-white/50 ring-white/10;
    }
  }
</style>
