---
import GitHub from "./icons/GitHub.astro"
import Link from "./icons/Link.astro"
import LinkButton from "./LinkButton.astro"
import CPlusPlus from "./icons/CPlusPlus.astro"
import Python from "./icons/Python.astro"
import ROS2 from "./icons/ROS2.astro"
import C from "./icons/C.astro"
import Lua from "./icons/Lua.astro"
import CMake from "./icons/CMake.astro"
import Dart from "./icons/Dart.astro"
import OpenCV from "./icons/OpenCV.astro"
import MediaPipe from "./icons/MediaPipe.astro"
import PyTorch from "./icons/PyTorch.astro"
import type { Translation } from "@/i18n"

interface Props {
  t: Translation
}

const { t } = Astro.props

const TAGS = {
  CPLUSPLUS: {
    name: "C++",
    class: "bg-blue-700 text-white",
    icon: CPlusPlus,
  },
  PYTHON: {
    name: "Python",
    class: "bg-yellow-500 text-black",
    icon: Python,
  },
  ROS2: {
    name: "ROS2",
    class: "bg-gray-800 text-white",
    icon: ROS2,
  },
  C: {
    name: "C",
    class: "bg-green-500 text-white",
    icon: C,
  },
  LUA: {
    name: "Lua",
    class: "bg-blue-600 text-white",
    icon: Lua,
  },
  CMAKE: {
    name: "CMake",
    class: "bg-red-500 text-white",
    icon: CMake,
  },
  DART: {
    name: "Dart",
    class: "bg-blue-400 text-white",
    icon: Dart,
  },
  OPENCV: {
    name: "OpenCV",
    class: "bg-[#5C3EE8] text-white",
    icon: OpenCV,
  },
  MEDIAPIPE: {
    name: "MediaPipe",
    class: "bg-[#00C2A0] text-white",
    icon: MediaPipe,
  },
  PYTORCH: {
    name: "PyTorch",
    class: "bg-[#EE4C2C] text-white",
    icon: PyTorch,
  },
}

const PROJECTS = [
  {
    id: "eyetracker" as const,
    github: "https://github.com/YssfDevOps/eye-tracker-vocacions",
    link: "https://rlpengineeringschooluab2024.wordpress.com/2024/07/04/gmr-ai/",
    image: "/projects/eyetracker.png",
    tags: [TAGS.PYTHON, TAGS.OPENCV, TAGS.MEDIAPIPE, TAGS.PYTORCH],
  },
  {
    id: "gmrai" as const,
    github: "https://github.com/GMR-AI/GMR-AI",
    link: "https://rlpengineeringschooluab2024.wordpress.com/2024/07/04/gmr-ai/",
    image: "/projects/gmrai.png",
    tags: [TAGS.PYTHON, TAGS.ROS2, TAGS.C, TAGS.CMAKE, TAGS.LUA, TAGS.CPLUSPLUS],
  },
  {
    id: "mygmr" as const,
    github: "https://github.com/GMR-AI/MyGMR",
    image: "/projects/mygmr.png",
    tags: [TAGS.DART, TAGS.PYTHON],
  },
  {
    id: "reconstruction" as const,
    github: "https://github.com/GMR-AI/3D-Reconstruction",
    image: "/projects/3d.png",
    tags: [TAGS.PYTHON],
  },
  {
    id: "rain" as const,
    github: "https://github.com/YssfDevOps/Rain-In-Australia-Kaggle-Prediction-Project",
    image: "/projects/rain.png",
    tags: [TAGS.PYTHON],
  },
  {
    id: "treasure" as const,
    github: "https://github.com/JG03dev/Treasure-track",
    image: "/projects/treasure.png",
    tags: [TAGS.CPLUSPLUS, TAGS.C, TAGS.CMAKE],
  },
]
---

<div class="flex flex-col gap-y-16">
  {
    PROJECTS.map(({ id, image, tags, link, github }) => {
      const copy = t.projects[id]
      return (
        <article class="flex flex-col space-x-0 space-y-8 group md:flex-row md:space-x-8 md:space-y-0 rtl:md:space-x-reverse">
          <div class="w-full md:w-1/2">
            <div class="relative flex flex-col items-center col-span-6 row-span-5 gap-8 transition duration-500 ease-in-out transform shadow-xl overflow-clip rounded-xl sm:rounded-xl md:group-hover:-translate-y-1 md:group-hover:shadow-2xl lg:border lg:border-gray-800 lg:hover:border-gray-700 lg:hover:bg-gray-800/50">
              <img
                alt={copy.title}
                class="object-cover object-top w-full h-56 transition duration-500 sm:h-full md:scale-110 md:group-hover:scale-105"
                loading="eager"
                src={image}
              />
            </div>
          </div>

          <div class="w-full md:w-1/2 md:max-w-lg">
            <h3 class="text-2xl font-bold text-gray-800 dark:text-gray-100">
              {copy.title}
            </h3>
            <div class="flex flex-wrap mt-2">
              <ul class="flex flex-row flex-wrap mb-2 gap-x-2 gap-y-2">
                {tags.map((tag) => (
                  <li>
                    <span class={`flex gap-x-2 rounded-full text-xs ${tag.class} py-1 px-2 `}>
                      <tag.icon class="size-4" />
                      {tag.name}
                    </span>
                  </li>
                ))}
              </ul>

              <div class="mt-2 text-gray-700 dark:text-gray-400">{copy.description}</div>
              <footer class="flex items-end justify-start mt-4 gap-x-4">
                {github && (
                  <LinkButton href={github}>
                    <GitHub class="size-6" />
                    {t.projects.code}
                  </LinkButton>
                )}
                {link && (
                  <LinkButton href={link}>
                    <Link class="size-4" />
                    {t.projects.preview}
                  </LinkButton>
                )}
              </footer>
            </div>
          </div>
        </article>
      )
    })
  }
</div>
