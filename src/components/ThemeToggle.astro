---
import SunIcon from "./icons/Sun.astro"
import MoonIcon from "./icons/Moon.astro"
import SystemIcon from "./icons/System.astro"

interface Props {
  label: string
  light: string
  dark: string
  system: string
}

const { label, light, dark, system } = Astro.props

const THEMES = [
  { id: "light", name: light },
  { id: "dark", name: dark },
  { id: "system", name: system },
]
---

<div class="relative ms-1 me-1">
  <button
    id="theme-toggle-btn"
    type="button"
    class="appearance-none border-none flex hover:scale-125 transition"
  >
    <span class="sr-only">{label}</span>
    <SunIcon id="light" class="theme-toggle-icon size-5 transition-all" />
    <MoonIcon
      id="dark"
      class="theme-toggle-icon absolute size-5 transition-all"
    />
    <SystemIcon
      id="system"
      class="theme-toggle-icon absolute size-5 transition-all"
    />
  </button>
  <div
    id="themes-menu"
    class="absolute hidden scale-80 top-8 end-0 text-sm p-1 min-w-[8rem] rounded-md border border-gray-100 bg-white/90 dark:bg-gray-900/90 dark:border-gray-500/20 shadow-[0_3px_10px_rgb(0,0,0,0.2)] backdrop-blur-md z-20"
  >
    <ul>
      {
        THEMES.map((theme) => (
          <li
            class="themes-menu-option px-2 py-1.5 cursor-default hover:bg-neutral-400/40 dark:hover:bg-gray-500/50 rounded-sm"
            data-theme={theme.id}
          >
            {theme.name}
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  #themes-menu.open {
    display: inline;
    animation: scale-up-center 0.15s cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
  }

  @keyframes scale-up-center {
    from {
      transform: scale(0.8);
      opacity: 0;
    }

    to {
      transform: scale(1);
      opacity: 1;
    }
  }
</style>

<script is:inline>
  ;(() => {
    const matchMedia = window.matchMedia("(prefers-color-scheme: dark)")

    const getThemePreference = () =>
      (typeof localStorage !== "undefined" && localStorage.getItem("theme")) ||
      "system"

    const updateTheme = () => {
      const themePreference = getThemePreference()
      const isDark =
        themePreference === "dark" ||
        (themePreference === "system" && matchMedia.matches)

      document.querySelectorAll(".theme-toggle-icon").forEach((element) => {
        element.style.scale = element.id === themePreference ? "1" : "0"
      })
      document.documentElement.classList.toggle("dark", isDark)
    }

    // (Re)bind the toggle button and menu options. This must run again after
    // each client-side view transition because Astro swaps in fresh DOM nodes
    // and does not re-execute this inline script.
    const setupThemeToggle = () => {
      const button = document.getElementById("theme-toggle-btn")
      const themesMenu = document.getElementById("themes-menu")
      if (!button || !themesMenu) return

      updateTheme()

      button.onclick = (e) => {
        e.stopPropagation()
        document.getElementById("languages-menu")?.classList.remove("open")
        const isClosed = !themesMenu.classList.contains("open")
        themesMenu.classList.toggle("open", isClosed)
      }

      themesMenu.querySelectorAll(".themes-menu-option").forEach((element) => {
        element.onclick = () => {
          const value = element.getAttribute("data-theme")
          if (value) {
            localStorage.setItem("theme", value)
            updateTheme()
          }
          themesMenu.classList.remove("open")
        }
      })
    }

    // Listeners registered on the persistent document (once, since this inline
    // script is not re-run across view transitions).
    document.addEventListener("click", () =>
      document.getElementById("themes-menu")?.classList.remove("open")
    )
    matchMedia.addEventListener("change", updateTheme)
    document.addEventListener("astro:after-swap", updateTheme)
    document.addEventListener("astro:page-load", setupThemeToggle)

    setupThemeToggle()
  })()
</script>
