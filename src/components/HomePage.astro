---
import Layout from "@/layouts/Layout.astro"
import AboutMe from "@/components/AboutMe.astro"
import Briefcase from "@/components/icons/Briefcase.astro"
import Book from "@/components/icons/Book.astro"
import CodeIcon from "@/components/icons/Code.astro"
import Experience from "@/components/Experience.astro"
import Study from "@/components/Study.astro"
import ProfileCheck from "@/components/icons/ProfileCheck.astro"
import Projects from "@/components/Projects.astro"
import Skills from "@/components/Skills.astro"
import Certifications from "@/components/Certifications.astro"
import SectionContainer from "@/components/SectionContainer.astro"
import Hero from "@/components/Hero.astro"
import StackIcon from "@/components/icons/Stack.astro"
import CertificateIcon from "@/components/icons/Certificate.astro"
import { useTranslations, type Locale } from "@/i18n"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = useTranslations(locale)
---

<Layout locale={locale}>
  <main class="px-4">
    <SectionContainer class="py-16 md:py-36">
      <Hero t={t} />
    </SectionContainer>
    <div class="space-y-24">
      <SectionContainer id="experiencia">
        <h2
          class="flex items-center mb-6 text-3xl font-semibold gap-x-3 text-black/80 dark:text-white"
        >
          <Briefcase class="size-8" />
          {t.sections.experience}
        </h2>
        <Experience t={t} />
      </SectionContainer>

      <SectionContainer id="habilidades">
        <h2
          class="flex items-center mb-6 text-3xl font-semibold gap-x-3 text-black/80 dark:text-white"
        >
          <StackIcon class="size-8" />
          {t.sections.skills}
        </h2>
        <Skills t={t} />
      </SectionContainer>

      <SectionContainer id="proyectos">
        <h2
          class="flex items-center mb-6 text-3xl font-semibold gap-x-3 text-black/80 dark:text-white"
        >
          <CodeIcon class="size-7" />
          {t.sections.projects}
        </h2>
        <Projects t={t} />
      </SectionContainer>

      <SectionContainer id="estudio">
        <h2
          class="flex items-center mb-6 text-3xl font-semibold gap-x-3 text-black/80 dark:text-white"
        >
          <Book class="size-8" />
          {t.sections.education}
        </h2>
        <Study t={t} />
      </SectionContainer>

      <SectionContainer id="certificaciones">
        <h2
          class="flex items-center mb-6 text-3xl font-semibold gap-x-3 text-black/80 dark:text-white"
        >
          <CertificateIcon class="size-8" />
          {t.sections.certifications}
        </h2>
        <Certifications t={t} />
      </SectionContainer>

      <SectionContainer id="sobre-mi">
        <h2
          class="flex items-center mb-6 text-3xl font-semibold gap-x-8 text-black/80 dark:text-white"
        >
          <ProfileCheck class="size-8" />
          {t.sections.about}
        </h2>
        <AboutMe t={t} />
      </SectionContainer>
    </div>
  </main>
</Layout>
