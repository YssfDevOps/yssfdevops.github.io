---
interface Props {
  title: string
  company: string
  description?: string
  date: string
}

const { title, company, description, date } = Astro.props
---

<div
  class="relative mx-12 pb-12 grid before:absolute before:start-[-35px] before:block before:h-full before:border-s-2 before:border-black/20 dark:before:border-white/15 before:content-[''] md:grid-cols-5 md:gap-10"
>
  <div class="relative pb-4 md:col-span-2">
    <div class="sticky top-0">
      <span class="text-blue-400 -start-[42px] absolute rounded-full text-5xl">•</span>
      <h3 class="text-xl font-bold text-blue-400 text-pretty">{title}</h3>
      <h4 class="font-semibold text-xl text-gray-600 dark:text-white text-pretty">
        {company}
      </h4>
      <time class="p-0 m-0 text-sm text-gray-600/80 dark:text-white/80">{date}</time>
    </div>
  </div>
  {
    description && (
      <div class="relative flex flex-col gap-2 pb-4 text-gray-600 dark:text-gray-300 md:col-span-3">
        <p>{description}</p>
      </div>
    )
  }
</div>
